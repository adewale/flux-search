{
  "name": "flux-search",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply flux-search-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply flux-search-db --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "corpus:fetch": "bash scripts/fetch-corpus.sh",
    "corpus:process": "npx tsx scripts/process-corpus.ts",
    "corpus:validate": "npx tsx scripts/validate-corpus.ts",
    "corpus:pipeline": "npm run corpus:fetch && npm run corpus:process && npm run corpus:validate",
    "metrics:topic-queue": "node scripts/topic-queue-metrics.mjs",
    "smoke:queue-metrics": "node scripts/topic-queue-metrics.mjs",
    "smoke:operator-routes": "node scripts/smoke-operator-routes.mjs",
    "smoke:queue-local": "node scripts/smoke-queue-local.mjs",
    "characterize:topics:inline": "node scripts/characterize-topics.mjs inline",
    "characterize:topics:queue": "node scripts/characterize-topics.mjs queue",
    "compare:queue-public-surfaces": "node scripts/compare-queue-public-surfaces.mjs",
    "smoke:admin-topic-rebuild": "node scripts/admin-topic-rebuild-smoke.mjs",
    "db:explain-hot-paths": "node scripts/explain-d1-hot-paths.mjs",
    "build:background-frequency": "node scripts/build-background-frequency.mjs"
  },
  "dependencies": {
    "@ade_oshineye/yaket": "0.5.3",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "fast-check": "^4.6.0",
    "nodewordfreq": "^0.2.1",
    "playwright": "^1.59.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.2",
    "wrangler": "^4.10.0"
  }
}
