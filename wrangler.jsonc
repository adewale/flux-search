{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flux-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/search", "/autocomplete", "/random-quote", "/latest-issue", "/issues/*", "/admin/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flux-search-db",
      "database_id": "97919396-1de8-419e-826b-de6bcbd40448",
      "migrations_dir": "migrations"
    }
  ],

  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "flux-search-chunks"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "LEXICAL_WEIGHT": "1.0",
    "SEMANTIC_WEIGHT": "0.55",
    "RRF_K": "40"
  },

  "triggers": {
    "crons": ["0 6 * * SAT"]
  },

  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
